generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id_user      Int    @id @default(autoincrement())
  nome_usuario String
  email        String
  senha        String
  cpf          String
  senha_pdv    String
  tipo_user    String @db.VarChar(1)
  telefone     Int
}
