generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id_user      Int    @id @default(autoincrement())
  nome_usuario String
  email        String @unique
  senha        String
  cpf          String @unique
  senha_pdv    String
  tipo_user    String
  telefone     String
  cod_verify   String?
  expira_em    DateTime?
}
